{
  "manifest_version": 3,
  "name": "Solver Core",
  "version": "3.4.0",
  "description": "Universal AI auto-solver for LMS DUT, LMS DES UDN, GDQP, Azota and any quiz website.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webRequest",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "https://*.azota.vn/*",
    "https://lms.dut.udn.vn/*",
    "http://lms.dut.udn.vn/*",
    "https://daotao.des.udn.vn/*",
    "http://daotao.des.udn.vn/*",
    "https://bun04.github.io/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.azota.vn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.azota.vn/*"],
      "js": ["stealth.js", "ai_bridge.js", "content_azota.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://lms.dut.udn.vn/*",
        "http://lms.dut.udn.vn/*",
        "https://daotao.des.udn.vn/*",
        "http://daotao.des.udn.vn/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lms.dut.udn.vn/*",
        "http://lms.dut.udn.vn/*",
        "https://daotao.des.udn.vn/*",
        "http://daotao.des.udn.vn/*"
      ],
      "js": ["stealth.js", "ai_bridge.js", "content_lms.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["https://bun04.github.io/GDQP-DHDN/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://bun04.github.io/GDQP-DHDN/*"],
      "js": ["stealth.js", "ai_bridge.js", "content_gdqp.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://*.azota.vn/*",
        "https://lms.dut.udn.vn/*",
        "http://lms.dut.udn.vn/*",
        "https://daotao.des.udn.vn/*",
        "http://daotao.des.udn.vn/*",
        "https://bun04.github.io/GDQP-DHDN/*"
      ],
      "js": ["stealth.js", "ai_bridge.js", "content_universal.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "stealth.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
